# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOOP_INTERVAL_MS=45000

# ── Security ─────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string in production
JWT_SECRET=dev-insecure-secret-change-me-0001
JWT_EXPIRES_IN=12h

# ── Firebase Admin SDK ───────────────────────────────────────────────────
# Leave blank (or EMULATOR_MODE=true) to run the in-memory emulator store.
EMULATOR_MODE=true
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_DATABASE_URL=https://kpc-yard-dev-default-rtdb.firebaseio.com

# ── Yard economics & SLA ─────────────────────────────────────────────────
DEMURRAGE_RATE_PER_HOUR_KES=12000
YARD_OPERATING_HOURS_PER_DAY=24
OPTIMAL_TURNAROUND_HOURS=4.5
WEIGHBRIDGE_TOLERANCE_PCT=5

# ── HTTP ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Alerting ─────────────────────────────────────────────────────────────
PAGERDUTY_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── TALK-SASA Bulk SMS ─────────────────────────────────────────────────────
# Sends chauffeur/driver SMS notifications. TALKSASA_API_KEY is the current
# alias; TALKSASA_API_TOKEN is kept for backward compatibility.
TALKSASA_API_KEY=
TALKSASA_API_TOKEN=
TALKSASA_SENDER_ID=TALK-SASA
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3/
TALKSASA_ENDPOINT=https://bulksms.talksasa.com/api/v3/sms/send